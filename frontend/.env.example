# MindSync AI - Local Environment Variables Example

# FastAPI Backend Base URL
# Use http://10.0.2.2:8000 for Android Emulator pointing to localhost
# Use http://localhost:8000 for iOS Simulator pointing to localhost
BACKEND_URL=http://10.0.2.2:8000

# Gemini API Key (Generate at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeather API Key (Generate at https://openweathermap.org)
OPENWEATHER_API_KEY=your_openweather_api_key_here
