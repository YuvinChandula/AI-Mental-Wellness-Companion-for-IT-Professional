# MindSync AI Backend Environment Configurations

PROJECT_NAME="MindSync AI Wellness Companion"
VERSION="1.0.0"
ENV="development" # development, testing, production

# CORS Configuration (comma separated)
ALLOWED_ORIGINS="*"

# Firebase Admin SDK Configuration
FIREBASE_CREDENTIALS_PATH="firebase-credentials.json"

# Groq API Configuration (Inference Model: Llama 3.3 70B)
GROQ_API_KEY="gsk_YOUR_GROQ_API_KEY_HERE"

# Rate Limiting Configuration (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Security Headers Switch
SECURE_HEADERS_ENABLED=true
